# ---------------------------------------------------------------------------
# Betta Plast — environment template (Приложение B мастер-промпта).
# Copy to .env.local (local dev) or set in the hosting panel. Never commit .env.
# ---------------------------------------------------------------------------

SITE_URL=https://example.kz
DEFAULT_TIMEZONE=Asia/Almaty
NODE_ENV=production

# --- Database -------------------------------------------------------------
# Postgres connection string (Supabase / Neon / Railway / self-hosted).
# If DATABASE_URL starts with "pglite:" or is left empty, the app falls back to
# an in-process PGlite database stored in .data/pglite (dev/demo only).
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Admin -----------------------------------------------------------------
SESSION_SECRET=change-me-long-random
ADMIN_BOOTSTRAP_EMAIL=owner@example.kz
ADMIN_BOOTSTRAP_PASSWORD=change-me-on-first-login

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=
TELEGRAM_LEADS_CHAT_ID=

# --- Cron ------------------------------------------------------------------
CRON_SECRET=change-me-long-random

# --- Contacts (defaults come from the 2GIS card; confirm the primary number) -
PHONE_PRIMARY=+77001074927
WHATSAPP_PRIMARY=77477043394
CONTACT_EMAIL=betta.plast07@gmail.com
INSTAGRAM_URL=https://instagram.com/bettaplast_karaganda
GIS_FIRM_URL=https://2gis.kz/karaganda/firm/11822477302933245
GIS_REVIEWS_URL=https://2gis.kz/karaganda/firm/11822477302933245/tab/reviews

# --- Notifications / integrations -----------------------------------------
RESEND_API_KEY=
RESEND_FROM=
NOTIFY_EMAIL_TO=
LEAD_WEBHOOK_URL=

# --- Storage (uploads: lead photos, gallery) -------------------------------
# Local disk storage is used when no blob/S3 credentials are provided.
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Anti-spam -------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (loaded only after cookie consent) --------------------------
YM_COUNTER_ID=
GA4_ID=
META_PIXEL_ID=

# --- Future phases ---------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Feature flags ---------------------------------------------------------
# off = prices are never shown in UI or API; range = "from X to Y" (after a
# confirmed price list is provided by the owner).
PRICE_DISPLAY=off
KK_ENABLED=false
AI_ASSISTANT_ENABLED=false
ORDER_STATUS_PAGE_ENABLED=false
SLA_FIRST_RESPONSE_MINUTES=10
